# Leave as /api when the website and API share one address (recommended). Otherwise the full API URL, e.g. https://api.yoursite.com/api
VITE_API_URL=/api
# Shown on the Terms and Privacy pages
VITE_CONTACT_EMAIL=contact@yourdomain.com
VITE_SITE_NAME=VirasatVault
# Public address printed inside QR codes. Defaults to the address the page is opened on.
# VITE_SITE_URL=https://yourdomain.com
# true shows "sample data" notices and demo-only sections. Keep false for the real site.
VITE_DEMO_MODE=false
