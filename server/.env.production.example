# Settings for the live website. Put these in your host's "Environment" screen (never commit real values).
NODE_ENV=production
SERVE_CLIENT=true                       # this server also serves the website, so one address does everything
PUBLIC_URL=https://yourdomain.com       # the public address, with https
SITE_URL=https://yourdomain.com
DATABASE_URL=postgresql://...           # from Neon / Supabase / Render
DATABASE_SSL=true
JWT_SECRET=                             # 48+ random characters, see DEPLOYMENT.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VirasatVault <no-reply@yourdomain.com>
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
